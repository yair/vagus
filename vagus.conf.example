{
    "state_dir": "/home/oc/.vagus/state",
    "log_file": "/home/oc/.openclaw/logs/vagus.log",
    "telegram": {
        "zeresh_bot_token": "<ZERESH_TELEGRAM_BOT_TOKEN>",
        "jay_chat_id": "<JAY_TELEGRAM_CHAT_ID>"
    },
    "openclaw": {
        "gateway_url": "http://127.0.0.1:18789",
        "gateway_token": "<OC_GATEWAY_TOKEN>"
    },
    "scripts": {
        "check_usage": "/home/oc/.openclaw/workspace/scripts/check-usage.sh",
        "crontab_cmd": "crontab -l"
    },
    "thresholds": {
        "mail_stale_hours": 4,
        "mail_stale_escalate_hours": 6,
        "no_mail_hours": 48,
        "usage_scrape_fail_max": 6,
        "usage_5hr_warn": 70,
        "usage_weekly_warn": 80,
        "batch_work_cooldown_min": 60,
        "cron_rewake_hours": 2,
        "cron_escalate_hours": 4,
        "junior_rewake_hours": 2,
        "zeresh_mail_rewake_hours": 4,
        "usage_5hr_alert_cooldown_min": 30,
        "usage_weekly_alert_cooldown_min": 360
    },
    "nodes": {
        "zhizi-zeresh": {
            "enabled": true,
            "stale_hours": 1,
            "alert_cooldown_hours": 2
        }
    },
    "quiet_hours": {
        "start": 23,
        "end": 8
    },
    "working_hours": {
        "start": 10,
        "end": 19
    }
}
